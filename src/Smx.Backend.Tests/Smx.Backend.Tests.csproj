<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smx.Domain\Smx.Domain.csproj" />
    <ProjectReference Include="..\Smx.Backend\Smx.Backend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A real 16-section GHS SDS, already committed for Smx.Functions.Tests. Linked rather than
         copied: one fixture, one place to update, and no new binary in the tree. -->
    <Content Include="../Smx.Functions.Tests/Resources/real-sds-nd2o3.pdf"
             Link="Resources/real-sds-nd2o3.pdf" CopyToOutputDirectory="PreserveNewest" />
    <!-- Linked, not copied: this is the repo's own HLD, and it happens to be a real specimen of a
         PDF whose subsetted fonts carry no ToUnicode map for their fi/fl ligatures and list
         numerals. Those glyphs come out of ANY extractor as U+0000 (pypdf reproduces it), so it is
         the honest fixture for the unmapped-glyph tests below. -->
    <Content Include="../../project_files/SMX_Final_HLD.pdf"
             Link="Resources/subsetted-fonts.pdf" CopyToOutputDirectory="PreserveNewest" />
    <!-- Committed rather than generated in-test (unlike the docx/xlsx fixtures): PdfPig reads PDFs,
         it does not write them, so there is no way to build an encrypted one from this test project.
         5 KB, and it is the only way to pin the message an operator sees for a protected file. -->
    <None Update="Resources/**"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <!-- Smx.Domain.Documents.SdsRegistryKey is a hand-copy of DedupKey.Norm/ForRegistry, because
         DedupKey lives in the OTHER solution (Smx.Functions.sln) and cannot be referenced from here.
         A copy that drifts silently empties the SDS text view, so the original is COMPILED INTO this
         test assembly and SdsRegistryKeyTests asserts the two agree. Source only — no project
         reference, no Functions dependency in the product code. -->
    <Compile Include="../Smx.Functions/Sds/Domain/DedupKey.cs" Link="Mirrored/DedupKey.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Smx.Domain.Tests/Fakes/InMemoryRecordStore.cs" Link="Fakes/InMemoryRecordStore.cs" />
    <Compile Include="../Smx.Domain.Tests/Fakes/InMemoryRunStore.cs" Link="Fakes/InMemoryRunStore.cs" />
    <Compile Include="../Smx.Domain.Tests/Fakes/InMemoryKnowledgeStore.cs" Link="Fakes/InMemoryKnowledgeStore.cs" />
    <Compile Include="../Smx.Domain.Tests/Fakes/InMemorySdsCorpusReader.cs" Link="Fakes/InMemorySdsCorpusReader.cs" />
    <Compile Include="../Smx.Domain.Tests/Fakes/InMemoryIntakeSessionStore.cs"
             Link="Fakes/InMemoryIntakeSessionStore.cs" />
    <Compile Include="../Smx.Domain.Tests/Fakes/InMemoryDocumentSources.cs"
             Link="Fakes/InMemoryDocumentSources.cs" />
    <Compile Include="../Smx.Domain.Tests/Fakes/InMemoryDocumentContentStore.cs"
             Link="Fakes/InMemoryDocumentContentStore.cs" />
    <Compile Include="../Smx.Domain.Tests/Fakes/InMemoryDocumentTextReader.cs"
             Link="Fakes/InMemoryDocumentTextReader.cs" />
    <Compile Include="../Smx.Domain.Tests/Fakes/InMemoryAttachmentBlobStore.cs"
             Link="Fakes/InMemoryAttachmentBlobStore.cs" />
    <!-- FakeAgentRuns / FakeTools / FakeKnowledgeWriting used to be LINKED in from Smx.Orchestrator.Tests.
         They now live in this project's own Fakes/ folder — the orchestrator's tests were folded in here —
         so they compile by glob, and an explicit Compile Include would be a duplicate-file build error. -->
  </ItemGroup>

</Project>